{
  "name": "kousa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=server --filter=web",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "pnpm --filter web run dev",
    "dev:server": "pnpm --filter server run dev",
    "db:push": "turbo run db:push -F @kousa/db --",
    "db:studio": "turbo run db:studio -F @kousa/db --",
    "db:generate": "turbo run db:generate -F @kousa/db --",
    "db:migrate": "turbo run db:migrate -F @kousa/db --",
    "deploy": "turbo run deploy -F @kousa/infra --",
    "destroy": "turbo run destroy -F @kousa/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run format:check",
    "services:up": "docker compose -f compose.local.yaml up -d --wait",
    "services:down": "docker compose -f compose.local.yaml down",
    "services:logs": "docker compose -f compose.local.yaml logs -f",
    "test:e2e": "e2e run",
    "check-types:e2e": "tsc --project tests/e2e/tsconfig.json",
    "db:migrate:local": "pnpm --filter @kousa/db run db:migrate:local",
    "db:generate:local": "pnpm --filter @kousa/db run db:generate:local",
    "test:local": "pnpm --filter @kousa/db run test:local && pnpm --filter server run test:local"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@e2e-dev/web": "^0.14.0",
    "@kousa/config": "workspace:*",
    "@shadcn/lint": "^0.2.1",
    "@types/node": "catalog:",
    "e2e": "^0.19.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.24.0"
}
