{
  "name": "kousa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @kousa/db --",
    "db:studio": "turbo run db:studio -F @kousa/db --",
    "db:generate": "turbo run db:generate -F @kousa/db --",
    "db:migrate": "turbo run db:migrate -F @kousa/db --",
    "deploy": "turbo run deploy -F @kousa/infra --",
    "destroy": "turbo run destroy -F @kousa/infra --",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@kousa/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "catalog:",
    "@kousa/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.24.0"
}
