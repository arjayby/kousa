{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kousa-local",
  "main": "../src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 3000 },
  "vars": {
    "DATABASE_MODE": "local",
    "DATABASE_URL": "postgresql://kousa:kousa_local@127.0.0.1:5432/kousa",
    "BETTER_AUTH_URL": "http://localhost:3000",
    "BETTER_AUTH_SECRET": "local-development-only-secret-at-least-32-characters",
    "CORS_ORIGIN": "http://localhost:3001",
    "POLAR_ACCESS_TOKEN": "",
    "POLAR_SUCCESS_URL": "http://localhost:3001",
    "CLICKHOUSE_URL": "http://127.0.0.1:8123",
    "CLICKHOUSE_DATABASE": "kousa",
    "CLICKHOUSE_USERNAME": "kousa",
    "CLICKHOUSE_PASSWORD": "kousa_local",
  },
}
