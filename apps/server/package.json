{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen",
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --config local/wrangler.jsonc --local",
    "test:local": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@clickhouse/client-web": "^1.24.0",
    "@kousa/api": "workspace:*",
    "@kousa/auth": "workspace:*",
    "@kousa/db": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "4.0.3",
    "evlog": "^2.28.1",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hono/cli": "1.0.0-rc.6",
    "@kousa/config": "workspace:*",
    "@kousa/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "wrangler": "^4.149.0"
  }
}
