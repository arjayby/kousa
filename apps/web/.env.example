# Alchemy supplies DATABASE_URL from the managed Neon project.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=http://localhost:3001/success?checkout_id={CHECKOUT_ID}
# Copy the endpoint/CLI signing secret here. Never use POLAR_ACCESS_TOKEN for this.
POLAR_WEBHOOK_SECRET=

# Resend: verify mail.kousa.app, then create a Sending access key for that domain.
EMAIL_FROM=invites@mail.kousa.app
# Alchemy supplies this secret to local development and the deployed Worker.
RESEND_API_KEY=

# Liveblocks project secret key. Server only; do not use NEXT_PUBLIC_ here.
LIVEBLOCKS_SECRET_KEY=

# Vercel AI Gateway key. Server only; charged to the person running a node.
AI_GATEWAY_API_KEY=
# Optional public HTTPS origin serving this app and its R2 binding for image-to-video.
# Deployed apps default to BETTER_AUTH_URL. Local testing needs a public HTTPS tunnel.
GENERATION_MEDIA_ORIGIN=
