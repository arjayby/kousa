{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kousa-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  // Local OpenNext platform proxy only. Alchemy binds the deployed bucket.
  "services": [{ "binding": "GENERATION_JOBS", "service": "kousa-jobs-local" }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "kousa-media-local" },
  ],
}
