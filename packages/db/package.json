{
  "name": "@kousa/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b && tsc --project tsconfig.tests.json",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "drizzle-kit migrate --config drizzle.local.config.ts",
    "db:generate:local": "drizzle-kit generate --config drizzle.local.config.ts",
    "test:local": "tsx scripts/prepare-local-test.ts && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kousa/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
